<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.douyin" name="抖音" version="1.3.0" provider-name="xiaojiu885210-arch">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="zh_CN">在 Kodi 里看抖音。搜索、推荐连播、长按进作者主页、插件内关注和喜欢</summary>
    <summary lang="en_GB">Watch Douyin in Kodi. Search, autoplay, author pages, local follow and likes</summary>
    <description lang="zh_CN">非官方抖音视频插件。推荐播完自动下一条；长按 OK 进入作者主页、关注或喜欢（存在本机）。仅供个人学习使用。</description>
    <description lang="en_GB">Unofficial Douyin add-on. For personal use only.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/xiaojiu885210-arch/kodi</source>
    <website>https://github.com/xiaojiu885210-arch/kodi</website>
    <news lang="zh_CN">1.3.0: 插件内关注/喜欢；搜索；推荐连播；长按进作者主页。</news>
    <assets>
      <icon>resources/media/icon.png</icon>
      <fanart>resources/media/fanart.png</fanart>
    </assets>
    <reuselanguageinvoker>false</reuselanguageinvoker>
  </extension>
</addon>
