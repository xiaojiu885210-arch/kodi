<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="plugin.video.douyin">
    <category id="general" label="常规" help="">
      <group id="1" label="播放">
        <setting id="quality" type="string" label="画质" help="">
          <level>0</level>
          <default>1080p</default>
          <constraints>
            <options>
              <option>720p</option>
              <option>1080p</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>画质</heading>
          </control>
        </setting>
        <setting id="count" type="integer" label="每次加载数量" help="">
          <level>0</level>
          <default>20</default>
          <constraints>
            <minimum>10</minimum>
            <step>5</step>
            <maximum>40</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="device_id" type="string" label="设备 ID（自动生成）" help="">
          <level>2</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>设备 ID</heading>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
